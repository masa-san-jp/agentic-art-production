{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-production/approval.schema.json",
  "title": "Approval record",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "revision", "decision", "scope", "approver", "issued_at", "expires_at", "constraints"],
  "properties": {
    "approval_id": {"type": "string", "pattern": "^AP[0-9]{3,}$"},
    "revision": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revision"},
    "decision": {"enum": ["APPROVED", "DENIED", "REVOKED"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target_ref", "target_sha256"],
      "properties": {
        "action": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/effectType"},
        "target_ref": {"type": "string", "minLength": 1},
        "target_sha256": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/sha256"},
        "max_amount": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/money"}
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "authority": {"enum": ["HUMAN", "SYSTEM_POLICY"]}
      }
    },
    "issued_at": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "supersedes": {"oneOf": [{"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revisionRef"}, {"type": "null"}]}
  }
}
