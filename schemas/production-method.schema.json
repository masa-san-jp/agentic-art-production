{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "handoff_sha256",
    "medium",
    "environment",
    "specifications",
    "steps",
    "knowledge_uses",
    "uncertainties"
  ],
  "properties": {
    "contract_version": {
      "const": "production-method/v1"
    },
    "handoff_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "medium": {
      "enum": [
        "physical",
        "digital",
        "hybrid"
      ]
    },
    "environment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "status",
          "reason",
          "verification"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "PROPOSED",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_method",
              "actor",
              "condition"
            ],
            "properties": {
              "check_method": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "actor": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "condition": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "instruction",
          "actor",
          "conditions",
          "material_ids",
          "resource_ids",
          "requirement_ids",
          "specification_names",
          "completion_check",
          "evidence_status"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "material_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "resource_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "specification_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "completion_check": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_status": {
            "const": "NOT_RUN"
          }
        }
      }
    },
    "knowledge_uses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "code_commit",
          "knowledge_commit",
          "record_id",
          "source_conditions",
          "use"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "code_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "knowledge_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "record_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_conditions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "use": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "check_method",
          "actor",
          "condition"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "check_method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-production/production-method.schema.json",
  "title": "Production-owned proposed method, never an execution receipt"
}
