{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-production/observation-record.schema.json",
  "title": "Production observation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observation_id", "revision", "project_id", "statement",
    "method", "limitations", "related_requirement_ids", "observed_at", "observer",
    "source_refs", "privacy_status", "status", "supersedes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string", "pattern": "^OB[0-9]{3,}$"},
    "revision": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revision"},
    "project_id": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/projectId"},
    "statement": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "limitations": {"type": "string", "minLength": 1},
    "related_requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^RQ[0-9]{3,}$"}, "uniqueItems": true},
    "observed_at": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"},
    "observer": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["AGENT", "HUMAN", "SYSTEM"]}, "id": {"type": "string", "minLength": 1}}
    },
    "source_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision"],
          "properties": {
            "kind": {"enum": ["PROTOTYPE", "TASK", "OUTPUT", "QUALITY", "INSTALLATION"]},
            "id": {"type": "string", "minLength": 1},
            "revision": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revision"}
          }
        },
        {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/evidenceRef"}
      ]}
    },
    "privacy_status": {"enum": ["CLEAR", "PROJECT_INTERNAL", "REVIEW_REQUIRED", "UNKNOWN"]},
    "status": {"enum": ["ACTIVE", "RETRACTED"]},
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false, "required": ["observation_id", "revision"],
          "properties": {
            "observation_id": {"type": "string", "pattern": "^OB[0-9]{3,}$"},
            "revision": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revision"}
          }
        }
      ]
    }
  }
}
