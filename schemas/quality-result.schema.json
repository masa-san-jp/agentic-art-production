{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-production/quality-result.schema.json",
  "title": "Production quality result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quality_id", "revision", "project_id", "output_id", "output_revision", "status", "dimensions", "evidence_refs", "external_validation_status", "executed_at", "created_at", "created_by"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "quality_id": {"type": "string", "pattern": "^QL[0-9]{3,}$"},
    "revision": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revision"},
    "project_id": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/projectId"},
    "output_id": {"type": "string", "pattern": "^OUT[0-9]{3,}$"},
    "output_revision": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revision"},
    "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED", "EXTERNAL_VALIDATION_REQUIRED", "SKIPPED"]},
    "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "https://example.invalid/agentic-art-production/quality-result.schema.json#/$defs/dimension"}},
    "evidence_refs": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/evidenceRefs"},
    "external_validation_status": {"enum": ["NOT_REQUIRED", "PENDING", "VERIFIED"]},
    "executed_at": {"oneOf": [{"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
    "notes": {"type": "string"},
    "created_at": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"},
    "created_by": {"$ref": "https://example.invalid/agentic-art-production/quality-result.schema.json#/$defs/actor"}
  },
  "$defs": {
    "actor": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["AGENT", "HUMAN", "SYSTEM"]}, "id": {"type": "string", "minLength": 1}}},
    "dimension": {"type": "object", "additionalProperties": false, "required": ["id", "criterion", "result", "method"], "properties": {"id": {"type": "string", "pattern": "^QD[0-9]{3,}$"}, "criterion": {"type": "string", "minLength": 1}, "result": {"enum": ["PASS", "FAIL", "NOT_RUN", "EXTERNAL_VALIDATION_REQUIRED"]}, "method": {"type": "string", "minLength": 1}, "observation": {"type": "string"}}}
  }
}
