{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-production/agent-action-envelope.schema.json",
  "title": "Agent action envelope",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "action_id", "run_id", "invocation_id", "context_sha256", "capability_grant_sha256", "task_ref", "lease_ref", "kind", "payload", "idempotency_key", "decision"],
  "properties": {
    "schema_version": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/semver"}, "action_id": {"type": "string", "pattern": "^AAC[0-9]{6,}$"}, "run_id": {"type": "string", "pattern": "^ARN[0-9]{6,}$"}, "invocation_id": {"type": "string", "pattern": "^AIN[0-9]{6,}$"}, "context_sha256": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/sha256"}, "capability_grant_sha256": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/sha256"}, "task_ref": {"$ref": "#/$defs/task"}, "lease_ref": {"$ref": "#/$defs/lease"}, "kind": {"enum": ["RECORD_METADATA", "REQUEST_TOOL", "REQUEST_EFFECT", "REQUEST_APPROVAL", "STOP"]}, "payload": {"type": "object"}, "idempotency_key": {"type": "string", "minLength": 1}, "decision": {"enum": ["PROPOSED", "AUTHORIZED", "REJECTED", "APPLIED"]}
  },
  "$defs": {"task": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "sha256", "title", "effect_type", "acceptance_condition", "status", "lease_token_sha256", "lease_expires_at"], "properties": {"id": {"type": "string", "pattern": "^TK[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/sha256"}, "title": {"type": "string", "minLength": 1}, "effect_type": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/effectType"}, "acceptance_condition": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "lease_token_sha256": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/sha256"}, "lease_expires_at": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"}}}, "lease": {"type": "object", "additionalProperties": false, "required": ["task_id", "owner", "expires_at", "lease_token_sha256"], "properties": {"task_id": {"type": "string", "pattern": "^TK[0-9]{3,}$"}, "owner": {"type": "string", "minLength": 1}, "expires_at": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"}, "lease_token_sha256": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/sha256"}}}}
