{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-production/output-version.schema.json",
  "title": "Opaque production output version",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_id", "revision", "project_id", "deliverable_id", "version", "asset_ref", "status", "source_task_ids", "quality_result_ids", "created_at", "created_by"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "output_id": {"type": "string", "pattern": "^OUT[0-9]{3,}$"},
    "revision": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revision"},
    "project_id": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/projectId"},
    "deliverable_id": {"type": "string", "pattern": "^DL[0-9]{3,}$"},
    "version": {"type": "string", "minLength": 1},
    "asset_ref": {"$ref": "https://example.invalid/agentic-art-production/asset-reference.schema.json"},
    "status": {"enum": ["CANDIDATE", "AVAILABLE", "REJECTED", "SUPERSEDED"]},
    "source_task_ids": {"type": "array", "items": {"type": "string", "pattern": "^TK[0-9]{3,}$"}, "uniqueItems": true},
    "quality_result_ids": {"type": "array", "items": {"type": "string", "pattern": "^QL[0-9]{3,}$"}, "uniqueItems": true},
    "created_at": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"},
    "created_by": {"$ref": "https://example.invalid/agentic-art-production/output-version.schema.json#/$defs/actor"},
    "supersedes": {"oneOf": [{"$ref": "https://example.invalid/agentic-art-production/output-version.schema.json#/$defs/outputRef"}, {"type": "null"}]},
    "previews": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://example.invalid/agentic-art-production/output-version.schema.json#/$defs/preview"}},
    "gap": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/completionGap"}
  },
  "$defs": {
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "caption"],
      "properties": {
        "path": {"type": "string", "pattern": "^05_execution/previews/[A-Za-z0-9._-]+\\.(png|jpg|jpeg)$"},
        "caption": {"type": "string", "minLength": 1}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {"kind": {"enum": ["AGENT", "HUMAN", "SYSTEM"]}, "id": {"type": "string", "minLength": 1}}
    },
    "outputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_id", "revision"],
      "properties": {"output_id": {"type": "string", "pattern": "^OUT[0-9]{3,}$"}, "revision": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/revision"}}
    }
  }
}
