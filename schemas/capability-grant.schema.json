  "properties": {
    "schema_version": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/semver"}, "grant_id": {"type": "string", "pattern": "^ACG[0-9]{6,}$"}, "run_id": {"type": "string", "pattern": "^ARN[0-9]{6,}$"}, "task_ref": {"$ref": "#/$defs/ref"}, "allowed_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "allowed_tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "allowed_effect_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "read_scopes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "write_scopes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "target_hashes": {"type": "array", "items": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/sha256"}, "uniqueItems": true}, "expires_at": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/timestamp"}, "policy_version": {"type": "integer", "minimum": 1}, "policy_sha256": {"$ref": "https://example.invalid/agentic-art-production/common.schema.json#/$defs/sha256"}, "integrity": {"$ref": "#/$defs/integrity"}
  },
