{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fixture/production-handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "revision", "status", "research_project_id", "research_project_version", "research_commit", "generated_at", "selection", "creative_direction_ref", "requirements", "prototype_plan_ids", "constraints", "open_gaps", "replan_triggers", "source_refs", "integrity"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "handoff_id": {"type": "string", "pattern": "^HO[0-9]{3,}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "READY", "ACCEPTED", "REJECTED", "SUPERSEDED", "CANCELLED"]},
    "research_project_id": {"type": "string", "minLength": 1},
    "research_project_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "research_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "selected_hypothesis_id", "alternative_hypothesis_ids", "authority", "human_approval_required"],
      "properties": {
        "status": {"enum": ["AGENT_RECOMMENDED", "HUMAN_SELECTION_REQUIRED", "HUMAN_SELECTED"]},
        "selected_hypothesis_id": {"type": ["string", "null"]},
        "alternative_hypothesis_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authority": {"enum": ["AGENT", "HUMAN"]},
        "human_approval_required": {"type": "boolean"}
      }
    },
    "creative_direction_ref": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "priority", "source_decision_ids", "acceptance_test_ids"], "properties": {"id": {"type": "string"}, "statement": {"type": "string", "minLength": 1}, "priority": {"enum": ["mandatory", "important", "optional"]}, "source_decision_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "acceptance_test_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}}},
    "prototype_plan_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["rights", "safety", "privacy", "prohibited_actions"], "properties": {"rights": {"type": "array", "items": {"type": "string"}}, "safety": {"type": "array", "items": {"type": "string"}}, "privacy": {"type": "array", "items": {"type": "string"}}, "prohibited_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
    "open_gaps": {"type": "array", "items": {"type": "object"}},
    "replan_triggers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "source_refs": {"type": "object", "additionalProperties": false, "required": ["decision_ids", "insight_ids", "evidence_ids"], "properties": {"decision_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "insight_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["content_sha256"], "properties": {"content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
  }
}
