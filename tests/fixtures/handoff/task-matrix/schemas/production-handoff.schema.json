{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-research/production-handoff.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "revision", "status", "research_project_id", "research_project_version", "research_commit", "generated_at", "selection", "creative_direction_ref", "requirements", "prototype_plan_ids", "constraints", "open_gaps", "replan_triggers", "source_refs", "integrity"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "handoff_id": {"pattern": "^HO[0-9]{3,}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "READY"},
    "supersedes": {"oneOf": [{"type": "string", "pattern": "^HO[0-9]{3,}$"}, {"type": "object", "additionalProperties": false, "required": ["handoff_id", "revision"], "properties": {"handoff_id": {"type": "string", "pattern": "^HO[0-9]{3,}$"}, "revision": {"type": "integer", "minimum": 1}, "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, {"type": "null"}]},
    "research_project_id": {"type": "string", "minLength": 1},
    "research_project_version": {"type": "string", "minLength": 1},
    "research_commit": {"pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "selection": {"type": "object", "additionalProperties": false, "required": ["status", "selected_hypothesis_id", "alternative_hypothesis_ids", "authority", "human_approval_required"], "properties": {"status": {"enum": ["PROVISIONAL", "HUMAN_SELECTED"]}, "selected_hypothesis_id": {"pattern": "^PH[0-9]{3,}$"}, "alternative_hypothesis_ids": {"type": "array"}, "authority": {"enum": ["AGENT", "HUMAN"]}, "human_approval_required": {"type": "boolean"}}},
    "creative_direction_ref": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "priority", "source_decision_ids", "acceptance_test_ids"], "properties": {"id": {"pattern": "^RQ[0-9]{3,}$"}, "statement": {"type": "string", "minLength": 1}, "priority": {"enum": ["mandatory", "important", "optional"]}, "source_decision_ids": {"type": "array"}, "acceptance_test_ids": {"type": "array", "minItems": 1}}}},
    "prototype_plan_ids": {"type": "array", "items": {"pattern": "^PP[0-9]{3,}$"}},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["rights", "safety", "privacy", "prohibited_actions"], "properties": {"rights": {"type": "array"}, "safety": {"type": "array"}, "privacy": {"type": "array"}, "prohibited_actions": {"type": "array", "minItems": 1}}},
    "open_gaps": {"type": "array"},
    "replan_triggers": {"type": "array", "minItems": 1},
    "source_refs": {"type": "object", "required": ["decision_ids", "insight_ids", "evidence_ids"], "properties": {"decision_ids": {"type": "array", "minItems": 1}, "insight_ids": {"type": "array", "minItems": 1}, "evidence_ids": {"type": "array"}}},
    "integrity": {"type": "object", "required": ["content_sha256"], "properties": {"content_sha256": {"pattern": "^sha256:[0-9a-f]{64}$"}}}
  }
}
